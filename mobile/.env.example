# Android emulator. For a physical phone, use your development computer's LAN IP.
# Release builds require an HTTPS API.
API_BASE_URL=http://10.0.2.2:5000/api

# Public Android/server OAuth configuration, not a Google client secret.
GOOGLE_SERVER_CLIENT_ID=

# Public mobile map key. Restrict its use with the provider before deployment.
# Leave blank to use OpenStreetMap tiles.
GEOAPIFY_API_KEY=
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GEOAPIFY_TILE_URL=https://maps.geoapify.com/v1/tile/osm-carto/{z}/{x}/{y}.png?apiKey={apiKey}
MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
